# ── Profile ───────────────────────────────────────────────────────────────────
# dev  = infra runs without external keys; agents park leads if keys missing
# prod = boot FAILS unless every required key below is present (fail fast)
APP_PROFILE=dev
SEED_DEMO_DATA=false

# ── Infrastructure (docker-compose supplies these automatically in-network) ───
DATABASE_URL=postgresql://sdr:sdr@localhost:5432/sdr
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ── LLM ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Research ──────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SERPER_API_KEY=

# ── Contact discovery ─────────────────────────────────────────────────────────
HUNTER_API_KEY=
APOLLO_API_KEY=

# ── Gmail (OAuth2; get the refresh token via POST /api/gmail/auth once) ───────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
